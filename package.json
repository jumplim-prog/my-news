{
  "name": "my-news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "관심사별로 정렬되는 개인 뉴스 페이지",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/run.js",
    "check": "node --env-file-if-exists=.env scripts/check-feeds.js",
    "serve": "node --env-file-if-exists=.env -e \"import('node:http').then(async h=>{const{readFile}=await import('node:fs/promises');h.createServer(async(q,s)=>{try{const p=q.url==='/'?'/index.html':q.url.split('?')[0];const b=await readFile('docs'+p);s.writeHead(200,{'content-type':p.endsWith('.json')?'application/json':'text/html; charset=utf-8'});s.end(b)}catch{s.writeHead(404);s.end('not found')}}).listen(4321,()=>console.log('http://localhost:4321'))})\""
  }
}
